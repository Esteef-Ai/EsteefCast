<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#141619</color>
    <color name="panel">#1C1F23</color>
    <color name="line">#2F343A</color>
    <color name="brass">#C4A062</color>
    <color name="brass_bg">#2B2518</color>
    <color name="text">#E4E0D8</color>
    <color name="muted">#9A958C</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/brass</item>
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
    </style>

    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/brass</item>
        <item name="android:background">@color/panel</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
