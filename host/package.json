{
  "name": "esteefcast",
  "productName": "EsteefCast",
  "version": "0.1.0",
  "private": true,
  "description": "Share your PC screen and sound to your TV. By Esteef.Ai",
  "main": "main.js",
  "author": "Esteef.Ai",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "test": "node test/e2e.mjs",
    "test:remote": "node test/e2e-remote.mjs",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "ai.esteef.esteefcast",
    "productName": "EsteefCast",
    "copyright": "Esteef.Ai",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "web/**/*",
      "assets/**/*",
      "!test/**/*",
      "!scripts/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signExecutable": false,
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "EsteefCast-${version}-portable.exe"
    }
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "1.65.0"
  }
}
